# ---------------------------------------------------------------------------
# OAuth providers (accounts-data-layer slice)
# Register apps at:
#   Google: https://console.developers.google.com/apis/credentials
#   GitHub:  https://github.com/settings/applications/new
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# AI gateway (ai-gateway slice)
# OpenRouter API key: https://openrouter.ai/keys
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Cloudflare AI Gateway
# AIG_GATEWAY_ID: the AI Gateway that LLM traffic is routed through. Gateways are
#   per-environment — waypoint-dev (local), waypoint-staging, waypoint-prod — and the
#   deployed values are declared in wrangler.jsonc vars (top level, env.staging,
#   env.production; vars are NOT inherited between environments). All three gateways
#   must be created in the Cloudflare dashboard before gateway routing is deployed.
# AIG_ENABLED: kill switch. "true" routes through the gateway; "false" calls the
#   provider directly. String values, not booleans, so this file and wrangler.jsonc
#   agree — regenerate the env types with
#   `pnpm exec wrangler types --strict-vars=false` so both stay typed as string.
# ---------------------------------------------------------------------------
AIG_GATEWAY_ID=waypoint-dev
AIG_ENABLED=true

# ---------------------------------------------------------------------------
# Auth session signing (accounts-data-layer slice)
# BETTER_AUTH_SECRET: run `openssl rand -hex 32` to generate
# BETTER_AUTH_BASE_URL: the public URL of this deployment (http://localhost:3000 for dev)
# ---------------------------------------------------------------------------
BETTER_AUTH_SECRET=
BETTER_AUTH_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Cloudflare (platform-proofs / deploy)
# Account ID: Cloudflare dashboard → right sidebar
# API Token: https://dash.cloudflare.com/profile/api-tokens (needs Workers:Edit)
# ---------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
